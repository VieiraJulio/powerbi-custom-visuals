# Copie este arquivo para .env.local (que não é versionado) e preencha.
# Variáveis de ambiente com o mesmo nome têm precedência sobre o arquivo.

# Token PÚBLICO (pk.…) do Mapbox, restrito ao escopo de leitura de estilos/tiles.
MAPBOX_ACCESS_TOKEN=

# Conta e estilo do Mapbox usados no fundo do mapa.
# O token precisa pertencer à mesma conta dona do estilo.
MAPBOX_USERNAME=kevenaraujo
MAPBOX_STYLE_ID=cmqz9pcw7000401s12tom7zb1
