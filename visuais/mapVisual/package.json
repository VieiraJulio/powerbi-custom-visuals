{
  "name": "powerbi-map-visual",
  "private": true,
  "description": "Mapa de bolhas proporcionais por estado e cidade para Power BI, com seleção cruzada",
  "version": "1.0.0.12",
  "repository": {
    "type": "git",
    "url": "https://github.com/VieiraJulio/powerbi-custom-visuals.git",
    "directory": "visuais/mapVisual"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mapbox:config": "node scripts/write-mapbox-config.mjs",
    "pbiviz": "pbiviz",
    "prestart": "npm run mapbox:config",
    "start": "pbiviz start",
    "prepackage": "npm run mapbox:config",
    "package": "pbiviz package",
    "lint": "npx eslint .",
    "pretypecheck": "npm run mapbox:config",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/d3": "7.4.3",
    "d3": "7.9.0",
    "maplibre-gl": "^6.1.0",
    "powerbi-visuals-api": "~5.11.1",
    "powerbi-visuals-utils-formattingmodel": "6.0.4"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-plugin-powerbi-visuals": "^1.0.0",
    "typescript": "5.5.4"
  }
}
